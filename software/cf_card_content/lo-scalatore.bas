105 DATA 195,255,255,195,195,255,255,195
106 DATA 60,66,165,153,153,165,66,60
107 DATA 60,60,25,255,188,60,36,231
108 DATA 0,24,36,126,126,126,126,0
109 DATA 0,1,21,22,23,24,42,43,44,45,46,47
1091 DATA 3996,4003,4010,4016,4023,4029,4036,4043,4049,4056,4063
110 DIM CD(6):FOR N=0 TO 6:READ CD(N):NEXT
111 FOR N=0 TO 6:FOR M=0 TO 7:READ DT:VPOKE CD(N)*8+M,DT:NEXT:NEXT
112 VPOKE 8193,223:VPOKE 8194,143:VPOKE 8195,191:VPOKE 8197,31
113 FOR N=0 TO 11:READ B(N):OF=B(N)+32:BA(N)=6149+32*(OF#22)+(OF%22):NEXT
114 DIM DN(10):FOR N=0 TO 10:READ DN(N):NEXT:RETURN
