0 SCREEN 1:COLOR 1,15,15:VOLUME 0,15
1 DO(0)=-1:DO(1)=1:DI=DO(INT(RND(1)*2)):KEY 9,20,6
2 DIM B(11):DIM BA(11):DL=3
3 SC=1:CH=2:E1=0:E2=0:Z=16:J=8:E3=1:Q=10000:GOTO 10
4 IF Y>11 THEN 64
5 IF VPEEK(BA(Y))=24 THEN 9
6 Y=Y+1
7 GOTO 4
9 RETURN
10 GOSUB 100
15 GOSUB 70:H=0:Y=0
16 S=6821+INT(RND(1)*20):IF VPEEK(S+32)=0 THEN 16
17 T=VPEEK(S):VPOKE S,40
19 GOSUB 4:V=BA(Y):W=0:DO=DO(INT(RND(1)*2))
20 PAUSE DL:K=INKEY(0):IF K=0 THEN 41
21 IF K=32 THEN 35
22 IF K=28 THEN 28
23 IF K=30 THEN 31
24 IF K=29 THEN 33
25 IF K<>31 THEN 41
26 IF VPEEK(S+32)=Z THEN VPOKE S,T:S=S+32:GOTO 40
27 GOTO 41
28 DI=-1:IF VPEEK(S+31)>1 THEN VPOKE S,T:S=S-1:GOTO 40
29 IF T<>Z THEN VPOKE S,T:S=S+DI:T=VPEEK(S):GOTO 55
30 GOTO 41
31 IF T=Z THEN VPOKE S,T:S=S-32:GOTO 40
32 GOTO 41
33 DI=1:IF VPEEK(S+33)>1 THEN VPOKE S,T:S=S+1:GOTO 40
34 GOTO 29
35 SOUND 1,3996,5:VPOKE S,T:S=S-32+DI:T=VPEEK(S):VPOKE S,40:IF T=24 THEN 55
36 IF VPEEK(S+32)=24 THEN SS=SS+1000:GOSUB 95
37 FOR N=1 TO 5:NEXT:VPOKE S,T:S=S+32+DI:T=VPEEK(S):VPOKE S,40
38 IF VPEEK(S+32)<2 THEN 55
39 VPOKE S,40:SOUND 1,0,0:GOTO 41
40 SOUND 1,3730,1:T=VPEEK(S):VPOKE S,40
41 IF T=41 THEN SS=SS+150:GOSUB 95:H=H+1:T=0:IF H=16 THEN 64
42 IF T=24 THEN 55
43 GOSUB 98
45 VPOKE V,W:V=V+DO:W=VPEEK(V):VPOKE V,24
46 IF DO=32 AND VPEEK(V+32)=J THEN DO=DO(INT(RND(1)*2)):GOTO 48
47 IF W=1 THEN DO=32
48 IF W=40 THEN 55
49 IF V<6853 THEN 20
50 Y=Y+1:IF Y=12 THEN 55
51 VPOKE V,0:GOTO 19
52 IF VPEEK(S+32)<>J AND S<6853 THEN VPOKE S,T:S=S+32:T=VPEEK(S):VPOKE S,40
53 RETURN
55 SOUND 1,0,0:SO=255:IF T=24 THEN T=0
56 SO=SO-5:SOUND 1,4096-INT(26.6112*(255-SO)),0:GOSUB 52
57 FOR N=1 TO 17:NEXT:IF SO>155 THEN 56
58 SOUND 0:VOLUME 0,15:CH=CH-1:IF CH<0 THEN GOSUB 120:END
59 GOSUB 96:VPOKE V,W:Y=Y+1:IF W=40 THEN VPOKE V,T
60 IF Y>10 THEN 15
61 IF S>6842 THEN VPOKE S,T:GOTO 16
62 VPOKE S,40:GOTO 19
64 IF Y>10 THEN 67
65 FOR N=Y+1 TO 11:VPOKE BA(N),0:SS=SS+100:GOSUB 95:GOSUB 98:SOUND 4,17
66 FOR I=0 TO 10:SOUND 1,DN(I),1:NEXT:SOUND 0:VOLUME 0,15:NEXT
67 E2=E2+.05:SC=SC+1:E1=E1+1:IF E1>8 THEN E1=8
68 GOTO 15
70 CLS
71 VPOKE 6251,1:VPOKE 6260,1
72 VPOKE 6283,16:FOR N=6284 TO 6291:VPOKE N,8:NEXT:VPOKE 6292,16
73 VPOKE 6315,16:VPOKE 6324,16:VPOKE 6347,16:VPOKE 6356,16
74 GOSUB 95:GOSUB 96:FOR N=0 TO 11:VPOKE BA(N),24:NEXT
75 FOR N=6373 TO 6853 STEP 160:FOR C=1 TO 20:VPOKE N+C,J:NEXT:IF N=6853 THEN 82
76 FOR O=1 TO 3
77 R=N+1+INT(RND(1)*20):IF VPEEK(R)<>J THEN 77
78 FOR M=R TO R+128 STEP 32:VPOKE M,Z:NEXT
79 IF O>1 AND RND(1)<E2 THEN VPOKE R+(INT(RND(1)*2)+2)*32,1
80 IF RND(1)<.5 AND VPEEK(R-32)=0 THEN VPOKE R-32,1
81 NEXT
82 FOR O=1 TO E1
83 R=N+3+INT(RND(1)*16):IF VPEEK(R)<>J THEN 89
84 IF VPEEK(R-32)<>0 OR VPEEK(R+1)=0 OR VPEEK(R-1)=0 THEN 89
85 VPOKE R,0:VPOKE R-32,1
89 NEXT
90 FOR O=1 TO 4
91 R=N-32+INT(RND(1)*20):IF VPEEK(R)<>0 OR VPEEK(R+32)=0 THEN 91
92 VPOKE R,41:NEXT:NEXT
93 VPOKE 6189,1:VPOKE 6194,1:VPOKE 6220,1:VPOKE 6227,1
94 FOR N=6341 TO 6821 STEP 160:VPOKE N,1:NEXT:GOTO 97
95 LOCATE 8-LEN(STR$(SS)),0:PRINT SS;:RETURN
96 LOCATE 14,0:PRINT CH;:LOCATE 17,0:PRINT "#";SC;:RETURN
97 FOR N=6362 TO 6842 STEP 160:VPOKE N,1:NEXT:RETURN
98 IF SS>=Q*E3 THEN CH=CH+1:E3=E3+1:GOSUB 96
99 RETURN
